# SQLite database file
# Local dev:
DATABASE_PATH=./data/keepsupabasealive.db
# Docker / Coolify (required in production — never use ./data there):
# DATABASE_PATH=/data/keepsupabasealive.db

# --- Production (required when NODE_ENV=production) ---
# HTTP Basic Auth for dashboard + API (username defaults to "admin")
DASHBOARD_PASSWORD=change-me-to-a-long-random-password
# Only set if you want a non-admin username (do not leave blank in Coolify)
# DASHBOARD_USER=myuser

# Encrypts Supabase anon keys in SQLite (generate once, keep safe)
# openssl rand -hex 32
ENCRYPTION_KEY=

# Protects POST /api/cron
# openssl rand -hex 32
CRON_SECRET=

# --- Optional ---
# If the DB directory cannot create WAL sidecars (rare mounts): SQLITE_JOURNAL_MODE=DELETE
# Absolute path to migrations if `drizzle/` is not next to the server cwd
# DRIZZLE_MIGRATIONS_FOLDER=/app/drizzle

# Set to true to disable the built-in ping scheduler
# DISABLE_SCHEDULER=false

# Server port (Coolify sets PORT automatically)
PORT=3000
